APP_NAME="Billing SaaS"
APP_PRODUCT_NAME="Sveo Billing"
APP_PRODUCT_SHORT_NAME="Billing"
# APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://billing_saas.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_RUNTIME=web

# NativePHP desktop app (composer native:dev / native:build:mac / native:build:win)
NATIVEPHP_APP_ID=in.sveo.billing
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_AUTHOR="Sveo Technologies"
NATIVEPHP_APP_COPYRIGHT="Copyright © Sveo Technologies"
NATIVEPHP_APP_DESCRIPTION="Billing, accounting, inventory, and GST reporting for your business."
NATIVEPHP_APP_WEBSITE=https://sveo.in
NATIVEPHP_UPDATER_ENABLED=false
# Set to "sign" when building with an Apple Developer ID certificate
# NATIVEPHP_MAC_IDENTITY=sign
# NATIVEPHP_APPLE_ID=
# NATIVEPHP_APPLE_ID_PASS=
# NATIVEPHP_APPLE_TEAM_ID=

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Cloud / production PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=billing_saas
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound email (SMTP). Replace the YOUR_* placeholders below before sending email.
# MAIL_MAILER: smtp delivers over the network; log only writes messages to storage/logs.
# MAIL_ENCRYPTION: tls/starttls = STARTTLS (ports 25/587), ssl/smtps = implicit TLS (port 465),
# null/empty = let Laravel pick the scheme from MAIL_PORT. MAIL_SCHEME overrides it when set.
# Use an app password or provider API key, never your account password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Recipient of the in-app "Email SVEO" contact form.
BRANDING_VENDOR_EMAIL=hello@sveo.in

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
